# ===== 数据库 =====
DATABASE_URL=sqlite:///./instance/starter.db

# ===== JWT 认证 =====
JWT_SECRET_KEY=jwt-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 机器学习 =====
# 模型文件存储目录（.joblib 文件），相对于项目根目录
MODEL_DIR=data/models

# ===== 大模型 LLM（OpenAI 兼容协议，通义千问 qwen-flash）=====
# API Key 留空时自动降级：邮件生成接口返回 success=False，不影响其他功能
LLM_API_KEY=
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-flash
